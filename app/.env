# ======================
# Application
# ======================
APP_NAME=Upwork Bidders Management
APP_VERSION=2.0.0
DEBUG=False
API_V1_STR=/api/v1

# ======================
# Database
# ======================
DATABASE_URL=postgresql://postgres.hhhutpdjaozsyifglpmo:winara@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_TEST_URL=

# ======================
# Security
# ======================
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300000
REFRESH_TOKEN_EXPIRE_DAYS=2

# ======================
# Email
# ======================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=Upwork Bidders Management

# ======================
# File Upload
# ======================
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png", ".gif", ".pdf", ".doc", ".docx"]

# ======================
# Pagination
# ======================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ======================
# Rate Limiting
# ======================
RATE_LIMIT_PER_MINUTE=60

# ======================
# Analytics
# ======================
CACHE_ANALYTICS_MINUTES=15

# ======================
# Celery
# ======================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ======================
# CORS
# ======================
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ======================
# Default timezone
# ======================
DEFAULT_TIMEZONE=UTC+05:00

# ======================
# Connect costs
# ======================
DEFAULT_CONNECT_COST=0.15
BOOST_CONNECT_COST=0.15

# ======================
# Business rules
# ======================
BID_EDIT_WINDOW_DAYS=5

# ======================
# Cache settings
# ======================
REDIS_URL=redis://localhost:6379/1
CACHE_TTL_MINUTES=15
CACHE_ENABLED=True

# ======================
# Rate limiting
# ======================
RATE_LIMIT_ENABLED=True
DEFAULT_RATE_LIMIT=100

# ======================
# Export settings
# ======================
MAX_EXPORT_SIZE_MB=50
EXPORT_CLEANUP_HOURS=24
EXPORT_DIRECTORY=/data

# ======================
# Analytics thresholds
# ======================
WIN_RATE_BENCHMARK=15.0
COST_PER_WIN_THRESHOLD=50.0
ROI_THRESHOLD=100.0

# ======================
# Performance settings
# ======================
MAX_CHART_DATA_POINTS=365
QUERY_TIMEOUT_SECONDS=30

# ======================
# Security settings
# ======================
AUDIT_ENABLED=True
SENSITIVE_DATA_MASKING=True

# ======================
# ML/AI settings
# ======================
ENABLE_PREDICTIVE_ANALYTICS=True
MODEL_CONFIDENCE_THRESHOLD=0.7
