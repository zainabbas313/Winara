Generic single-database configuration.

# Base

/api/v1

---

# Common (All Roles)

## POST /auth/login

Request

json
{
  "email": "string",
  "password": "string",
  "device": {
    "ip_address": "string",
    "user_agent": "string",
    "os": "string",
    "browser": "string",
    "browser_version": "string",
    "device_type": "desktop|mobile|tablet"
  }
}


Response

json
{
  "access_token": "jwt",
  "expires_in": 3600,
  "refresh_token": "jwt",
  "token_type": "bearer",
  "session": {
    "id": "uuid",
    "status": "active|expired|invalidated|suspicious",
    "expires_at": "datetime"
  },
  "user": {
    "id": "uuid",
    "email": "string",
    "username": "string",
    "first_name": "string",
    "last_name": "string",
    "phone": "string|null",
    "bio": "string|null",
    "linkedin_profile_url": "string|null",
    "timezone": "string",
    "role": "admin|sub_admin|member",
    "status": "active|inactive|suspended",
    "team_id": "uuid|null",
    "is_active": true,
    "is_verified": true,
    "is_locked": false,
    "last_login": "datetime|null",
    "last_activity": "datetime|null",
    "created_at": "datetime",
    "updated_at": "datetime"
  }
}


## POST /auth/refresh

Request

json
{ "refresh_token": "jwt" }


Response

json
{
  "access_token": "jwt",
  "expires_in": 3600,
  "token_type": "bearer",
  "session": {
    "id": "uuid",
    "status": "active",
    "expires_at": "datetime"
  }
}


## POST /auth/logout

Request

json
{ "session_id": "uuid" }


Response

json
{ "success": true }


## POST /auth/forgot-password

Request

json
{ "email": "string" }


Response

json
{ "success": true }


## POST /auth/reset-password

Request

json
{ "token": "string", "new_password": "string" }


Response

json
{ "success": true }


## GET /sessions

Response

json
{
  "items": [
    {
      "id": "uuid",
      "user_id": "uuid",
      "status": "active|expired|invalidated|suspicious",
      "ip_address": "string|null",
      "user_agent": "string|null",
      "os": "string|null",
      "browser": "string|null",
      "browser_version": "string|null",
      "device_type": "desktop|mobile|tablet|null",
      "created_at": "datetime",
      "last_activity": "datetime",
      "expires_at": "datetime"
    }
  ],
  "next_cursor": null,
  "count": 1
}


## DELETE /sessions/{id}

Response

json
{ "success": true }


## GET /notifications

Query: is_read, type, since
Response

json
{
  "items": [
    {
      "id": "uuid",
      "user_id": "uuid",
      "type": "email|in_app|push",
      "title": "string",
      "message": "string",
      "is_read": false,
      "is_sent": true,
      "priority": 1,
      "entity_type": "string|null",
      "entity_id": "uuid|null",
      "sent_at": "datetime|null",
      "read_at": "datetime|null",
      "created_at": "datetime"
    }
  ],
  "next_cursor": null,
  "count": 1
}


## PATCH /notifications/{id}/read

Request

json
{ "is_read": true }


Response

json
{
  "id": "uuid",
  "is_read": true,
  "read_at": "datetime"
}


